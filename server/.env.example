PORT=4000

# Supabase. Without these the app falls back to the local JSON mock data.
# SUPABASE_SECRET_KEY bypasses row-level security — server-side only, never
# expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Leave blank to use the built-in offline summary (no API calls).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated CORS allowlist. Defaults to localhost:5173 when unset.
ALLOWED_ORIGINS=

# Shared secret gating purchase-order approval. When unset the approval
# endpoints are OPEN and the server warns at startup — set it before any
# deployment reachable by others.
APPROVAL_SECRET=
