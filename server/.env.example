PORT=4000

# Supabase. Without these the app falls back to the local JSON mock data.
# SUPABASE_SECRET_KEY bypasses row-level security — server-side only, never
# expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Leave blank to use the built-in offline summary (no API calls).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
